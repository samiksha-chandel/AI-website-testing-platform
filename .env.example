# SitePulse Configuration
PORT=3001
NODE_ENV=production

# Crawl Configuration
MAX_CRAWL_DEPTH=10
MAX_CRAWL_REQUESTS=500
MAX_CRAWL_CONCURRENCY=5

# HTTP Configuration
HTTP_CONCURRENCY=10
NAVIGATION_TIMEOUT=25000
REQUEST_TIMEOUT=12000
MAX_LINKS_TO_CHECK=500

# OWASP ZAP Configuration
# ZAP_PATH should point to the ZAP installation directory containing zap-2.17.0.jar
ZAP_PATH=
ZAP_PORT=8090
ZAP_TIMEOUT=120000
